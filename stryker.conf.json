{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.d.ts",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts"
  ],
  "coverageAnalysis": "perTest",
  "testRunner": "jest",
  "jest": {
    "configFile": "jest.config.js"
  },
  "thresholds": {
    "high": 80,
    "low": 50,
    "break": 40
  },
  "timeoutMS": 120000,
  "concurrency": 4,
  "ignoreStatic": true
}